# PCFBench evaluation suite — environment template.
#
# Copy this file to `.env`, then fill in your OpenRouter API key(s).
# .env is git-ignored, so your real keys never reach the repository.
#
#   cp .env.example .env
#   $EDITOR .env

# ── Required: OpenRouter API key(s) ──────────────────────────────────────
# Supply one or more numbered keys; the runner round-robins across them
# to maximise throughput while staying under per-account RPM limits.
OPENROUTER_API_KEY_1=sk-or-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# OPENROUTER_API_KEY_2=sk-or-...
# OPENROUTER_API_KEY_3=sk-or-...
#
# Alternatively a single fallback key, or a comma-separated list:
# OPENROUTER_API_KEY=sk-or-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# OPENROUTER_API_KEYS=sk-or-key1,sk-or-key2,sk-or-key3

# ── Optional: OpenRouter request attribution headers ─────────────────────
# Filled into HTTP-Referer / X-Title for the OpenRouter dashboard. Safe
# to leave at the defaults if you are not running a hosted service.
# OPENROUTER_SITE_URL=https://your-research-site.example
# OPENROUTER_APP_NAME=PCFBench

# ── Optional: runtime knobs (override the defaults baked into the CLI) ───
# DEFAULT_NUM_WORKERS=16
# DEFAULT_RPM_LIMIT=600
